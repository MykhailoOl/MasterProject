<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="logs/application.log"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>
    <springProperty name="auditPath" source="app.audit.path" defaultValue="logs/app-steps.log"/>
    <appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${auditPath}</file>
        <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level project=%X{project} call=%X{call} phase=%X{phase} prompt=%X{prompt} | %msg%n</pattern></encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${auditPath}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    <logger name="app.audit" level="INFO" additivity="false"><appender-ref ref="AUDIT"/><appender-ref ref="CONSOLE"/></logger>
    <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
